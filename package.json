{
  "name": "@ankhorage/studio-authoring",
  "version": "0.8.0",
  "description": "Reusable authoring core for Ankhorage apps",
  "license": "MIT",
  "homepage": "https://github.com/ankhorage/studio-authoring#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/studio-authoring/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/studio-authoring.git"
  },
  "keywords": [
    "ankhorage",
    "studio",
    "authoring",
    "manifest",
    "routes"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./screens": {
      "types": "./dist/screens.d.ts",
      "browser": "./dist/screens.js",
      "react-native": "./dist/screens.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "typecheck": "bun run check-types",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "knip:check": "ankhorage-knip",
    "format": "ankhorage-prettier --write .",
    "docs": "ankhorage-prettier --write README.md CHANGELOG.md",
    "test": "bun test",
    "test:packed-consumer": "bun run build && bun test test/packed-consumer.test.ts",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format:check": "ankhorage-prettier --check .",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "version-packages": "ankhorage-changeset version"
  },
  "dependencies": {
    "@ankhorage/contracts": "^26.9.0",
    "@ankhorage/utility": "^1.10.0"
  },
  "peerDependencies": {
    "@ankhorage/zora": "^27.2.0",
    "react": "19.2.3",
    "react-native": "0.86.x"
  },
  "peerDependenciesMeta": {
    "@ankhorage/zora": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ankhorage/devtools": "2.8.1",
    "@ankhorage/zora": "^27.2.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-test-renderer": "19.1.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.2"
}
