{
  "name": "@ankhorage/studio-authoring",
  "version": "0.1.0",
  "description": "Reusable authoring core for Ankhorage apps",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "knip:check": "knip",
    "format": "prettier --check .",
    "test": "bun test",
    "changeset": "changeset status"
  },
  "dependencies": {
    "@ankhorage/contracts": "^26.9.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/bun": "^1.4.4",
    "knip": "^5.79.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  }
}
